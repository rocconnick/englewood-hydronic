digraph H {
 graph [rankdir=LR,bgcolor="transparent",pad=.25,nodesep=.48,ranksep=.7,splines=polyline,fontname="Arial"];
 node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#9cb9d8",fontname="Arial",fontsize=12,margin=".18,.12"];
 edge [color="#6e879f",fontname="Arial",fontsize=10,arrowsize=.7];
 source [label="Two Polaris water heaters\nIN SERIES",fillcolor="#dceafe"];
 distribution [label="Hot-water distribution\n(as-built piping not fully traced)",fillcolor="#f1f5f9"];
 source -> distribution;
 mix1 [label="MC-1 — DuoMix 201\nMix 1 / Var 1 control",fillcolor="#d7eee8"];
 mix2 [label="MC-1 — DuoMix 201\nMix 2 / Var 2 control",fillcolor="#d7eee8"];
 base [label="Basement circulator +\nCaleffi 521 mixing valve",fillcolor="#d7eee8"];
 ah1 [label="AHU-1 — basement Lennox AM30\nhydronic air handler",fillcolor="#fff3df"];
 ah2 [label="AHU-2 — attic Lennox AM30\nhydronic air handler",fillcolor="#fff3df"];
 distribution -> {mix1 mix2 base ah1 ah2};
 z1 [label="Living Area\nMaster Bedroom\nMaster Bath"];
 z2 [label="Rest of Second Floor\nBedroom Above Garage"];
 zb [label="Basement radiant"];
 mix1 -> z1 [label="mixed radiant group"];
 mix2 -> z2 [label="mixed radiant group"];
 base -> zb;
 ah2 -> bad [label="pump reported bad",color="#c66a4b",fontcolor="#a34730"];
 bad [label="P-AHU2 circulator issue\n(model / circuit unknown)",fillcolor="#ffebe5",color="#e2a394"];
 legend [label="Conceptual functional topology\nNOT an as-built pipe schematic",shape=note,fillcolor="#fff8db",color="#d8bf77"];
}
