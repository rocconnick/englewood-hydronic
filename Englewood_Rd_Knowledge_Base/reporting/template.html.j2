<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Englewood Rd. | Heating System Field Guide</title><style>
:root{--ink:#17283a;--muted:#65758a;--navy:#132b45;--blue:#2874a6;--paper:#f5f7fa;--line:#dce4ed;--card:#fff;--green:#176b58;--amber:#99521b;--red:#a74633}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}a{color:#17618e}button{cursor:pointer} .layout{display:grid;grid-template-columns:270px minmax(0,1fr);min-height:100vh}.side{background:var(--navy);color:#dbe8f5;position:sticky;top:0;height:100vh;padding:28px 18px;overflow-y:auto}.brand{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#94b9d6}.side h1{font-size:22px;line-height:1.2;color:white;margin:9px 0 24px}.side a{display:block;padding:8px 12px;margin:3px 0;border-radius:8px;text-decoration:none;color:#d4e3f0;font-size:13px}.side a:hover,.side a.active{background:#284b6c;color:white}.side .small{font-size:11px;color:#a8bfd3;margin:24px 12px 0}.main{max-width:1420px;width:100%;padding:40px clamp(20px,4vw,65px) 100px;margin:auto}.eyebrow{color:var(--blue);text-transform:uppercase;letter-spacing:.15em;font-size:12px;font-weight:700}.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:center;margin-bottom:32px}.hero h1{font-size:clamp(29px,3vw,46px);line-height:1.14;letter-spacing:-.03em;margin:10px 0 14px}.hero p{color:var(--muted);max-width:590px}.hero img{width:100%;height:310px;object-fit:cover;border-radius:16px;box-shadow:0 14px 40px #0c263420}.chips{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}.chip{display:inline-flex;border-radius:999px;padding:5px 11px;background:#e6edf4;color:#38536a;font-size:12px;font-weight:650}.chip.warn{background:#fff0e6;color:#9a4a22}.chip.ok{background:#e0f4eb;color:#176b58}section{scroll-margin-top:20px;margin:38px 0}h2{font-size:25px;letter-spacing:-.025em;margin:0 0 15px}h3{font-size:18px;margin:22px 0 9px}.section-lead{color:var(--muted);margin-top:-7px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:0 3px 15px #0c263407}.card h3{margin:0 0 9px}.card p{margin:6px 0;color:#465a6b}.card .kicker{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--blue)}.card.problem{border-left:5px solid #ce7452}.card.neutral{border-left:5px solid #5d95b7}.stat{font-size:27px;font-weight:750;line-height:1.3}.muted{color:var(--muted)}.diagram{padding:20px;background:white;border:1px solid var(--line);border-radius:14px;margin:15px 0}.diagram img{width:100%;max-height:520px;object-fit:contain}.diagram figcaption{color:var(--muted);font-size:12px;margin-top:12px}.tablewrap{overflow-x:auto;background:white;border:1px solid var(--line);border-radius:12px}table{border-collapse:collapse;width:100%;font-size:13px}th,td{text-align:left;padding:11px 14px;border-bottom:1px solid #e7edf3;vertical-align:top}th{background:#edf3f8;color:#28425a}tr:last-child td{border-bottom:none}.good{color:var(--green);font-weight:750}.bad{color:var(--red);font-weight:750}.photo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.photo{background:white;border:1px solid var(--line);border-radius:12px;overflow:hidden;text-align:left;padding:0;color:inherit}.photo img{display:block;width:100%;height:155px;object-fit:cover}.photo span{display:block;font-size:12px;padding:10px;line-height:1.35;min-height:60px}.photo:hover{outline:2px solid #5c9dcc}.search{width:100%;border:1px solid #d0dce6;border-radius:9px;padding:12px;font:inherit;margin-bottom:12px}.source{background:white;border:1px solid var(--line);border-radius:12px;margin:8px 0;overflow:hidden}.source summary{cursor:pointer;padding:13px 18px;font-weight:700;background:#f8fbfd}.source .body{padding:14px 20px;overflow-wrap:anywhere}.source img{max-width:100%;max-height:380px}.source pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#eef3f7;padding:12px;border-radius:8px}.source blockquote{border-left:3px solid #8caec6;padding-left:15px;color:#526b80}.source table{margin:12px 0}.source h1{font-size:24px}.source h2{font-size:20px;margin-top:22px}.source h3{font-size:16px}.source a{overflow-wrap:anywhere}.callout{border-left:4px solid #c68b40;padding:14px 18px;background:#fff9ee;border-radius:8px}.footer{font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:22px;margin-top:45px}.modal{display:none;position:fixed;inset:0;background:#07111eea;z-index:10;align-items:center;justify-content:center;padding:25px}.modal.open{display:flex}.modal img{max-width:95vw;max-height:88vh;object-fit:contain}.modal button{position:absolute;top:12px;right:20px;color:white;background:#ffffff25;border:0;border-radius:8px;font-size:24px;padding:3px 13px}.modal .caption{position:absolute;bottom:5px;color:white;background:#07111e99;padding:5px 12px;border-radius:8px;font-size:12px}.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.toolbar button{background:#e6edf4;border:1px solid #d0dce6;border-radius:8px;padding:8px 12px;color:#2b4960}.print-only{display:none}@media(max-width:1000px){.layout{grid-template-columns:1fr}.side{position:relative;height:auto;padding:15px}.side h1{margin:3px 0 10px;font-size:19px}.side nav{display:flex;overflow-x:auto}.side a{white-space:nowrap}.side .small{display:none}.main{padding:25px 18px 70px}.hero{grid-template-columns:1fr}.hero img{height:260px}.grid{grid-template-columns:1fr 1fr}.photo-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:650px){.grid,.grid.two{grid-template-columns:1fr}.photo-grid{grid-template-columns:repeat(2,1fr)}.photo img{height:130px}}@media print{body{background:white}.layout{display:block}.side,.toolbar,.photo-grid,.modal{display:none!important}.main{padding:0;max-width:none}.card,.diagram,.source{break-inside:avoid;box-shadow:none}.source .body{display:block!important}.hero img{height:210px}.print-only{display:block}}
</style></head><body><div class="layout"><aside class="side"><div class="brand">Englewood Rd. · Field Guide</div><h1>Heating System<br>Knowledge Base</h1><nav>{% for id,label in nav %}<a href="#{{id}}">{{label}}</a>{% endfor %}</nav><div class="small">Built {{ generated }}<br>Source of truth: Markdown register<br>Diagrams show evidence levels.</div></aside><main class="main">
<header class="hero" id="overview"><div><div class="eyebrow">System overview / active investigation</div><h1>A living map of the heating system.</h1><p>Hydronic radiant floors, dual Polaris water heaters, two Lennox air handlers and a control cabinet with Wirsbo DuoMix 201 hydronic mixing controller. This report is generated from the Markdown knowledge base—not maintained as a second source of truth.</p><div class="chips"><span class="chip">6 radiant zones</span><span class="chip">2 water heaters</span><span class="chip">2 AM30 air handlers</span><span class="chip warn">2 active investigations</span></div><div class="toolbar"><button onclick="window.print()">Print / Save PDF</button><button onclick="document.getElementById('sources').scrollIntoView()">Read source notes</button></div></div><img alt="Full control cabinet" src="{{ cabinet }}"></header>
<section id="status"><div class="eyebrow">Active work</div><h2>What we're troubleshooting</h2><div class="grid two">{% for issue in issues %}<article class="card problem"><div class="kicker">Issue {{issue.number}} · Active investigation</div><h3>{{issue.title}}</h3>{{issue.html|safe}}</article>{% endfor %}</div></section>
<section id="architecture"><div class="eyebrow">Functional system</div><h2>Hydronic architecture</h2><p class="section-lead">Conceptual distribution paths only. Actual pipe tees, valves, mixing/injection connections and potable-water separation remain to be mapped.</p><figure class="diagram"><img alt="Hydronic system architecture" src="{{ diagrams.hydronic }}"><figcaption>Solid arrows depict documented functional groupings, not verified pipe-by-pipe routing. The attic AM30 air-handler hydronic circulator issue is separate from Mix 2.</figcaption></figure></section>
<section id="zones"><div class="eyebrow">Equipment map</div><h2>Radiant zones and air support</h2><div class="tablewrap"><table><thead><tr><th>Radiant zone</th><th>Control</th><th>Mix group</th><th>Supplemental air</th></tr></thead><tbody>{% for row in zones %}<tr>{% for val in row %}<td>{{val}}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div><figure class="diagram"><img alt="Thermostat staging functional diagram" src="{{ diagrams.staging }}"><figcaption>Five air thermostats: stage 1 radiant, stage 2 forced air. Exact thermostat-to-board and MABS HVAC zone control panel (ZCP-1) role and staging wiring remain unverified.</figcaption></figure></section>
<section id="controls"><div class="eyebrow">Control logic</div><h2>Demand wiring: what we've traced</h2><figure class="diagram"><img alt="Control wiring diagram" src="{{ diagrams.controls }}"><figcaption>Green and rust arrows indicate homeowner-traced conductors and measured states. Dashed lines are functional inferences—not verified physical conductors.</figcaption></figure><div class="grid"><div class="card"><div class="kicker">Upper radiant zone control module · Mix 1</div><div class="stat good">27.2 → ~1 VAC</div><p>Across ES/ES, idle → first-floor zone call. Brown ES lead traced to DuoMix terminal 1.</p></div><div class="card"><div class="kicker">Lower radiant zone control module · Mix 2</div><div class="stat bad">27.2 → 27.2 VAC</div><p>Across ES/ES, idle → both upstairs zones calling. Red ES lead traced to DuoMix terminal 3.</p></div><div class="card"><div class="kicker">Unresolved</div><div class="stat">ES prerequisites</div><p>White ES conductor travels toward transformer via upper radiant zone control module. DuoMix terminals 2 and 4 tied. Exact return and valve interlocks unverified.</p></div></div></section>
<section id="evidence"><div class="eyebrow">Evidence</div><h2>Diagnostic measurements</h2><div class="tablewrap"><table><thead><tr><th>Controller</th><th>State</th><th>Across ES/ES</th><th>Interpretation</th></tr></thead><tbody><tr><td>ZCM-1</td><td>Idle</td><td>27.2 VAC</td><td>Consistent with open ES</td></tr><tr><td>ZCM-1</td><td>First-floor call</td><td class="good">~1 VAC</td><td>Consistent with ES closure</td></tr><tr><td>ZCM-2</td><td>Idle</td><td>27.2 VAC</td><td>Consistent with open ES</td></tr><tr><td>ZCM-2</td><td>Both upstairs calling</td><td class="bad">27.2 VAC</td><td>No observed ES closure</td></tr></tbody></table></div><p class="muted">multimeter, V~ (AC) mode. All readings were reported by homeowner. Voltage across a contact does not by itself prove why it is open.</p><div class="callout"><strong>Safety:</strong> The cabinet contains 120 V and nominal 24 VAC circuits. These diagrams are investigative documentation, not an installation schematic or authorization to jumper terminals.</div></section>
<section id="next"><div class="eyebrow">Research backlog</div><h2>Highest-value unanswered questions</h2><div class="grid two"><article class="card"><h3>Mix 2 demand fault</h3><p>Do upstairs Honeywell valves physically open on a call? Does the ZCM-2 ES depend on valve end switches, a time delay, or other interlocks? What is the board's exact model and ES logic?</p></article><article class="card"><h3>Attic AM30 air-handler hydronic circulator</h3><p>Which pump model is installed, what exactly failed, and which thermostat/relay energizes it? Where are its isolation valves and service connections?</p></article></div></section>
<section id="gallery"><div class="eyebrow">Original photographs</div><h2>Visual evidence gallery</h2><p class="section-lead">Click any image to enlarge. Original photos are embedded for offline use.</p><div class="photo-grid">{% for photo in photos %}<button class="photo" data-image="{{photo.src}}" data-caption="{{photo.caption|e}}" aria-label="Enlarge {{photo.caption|e}}"><img loading="lazy" src="{{photo.src}}" alt="{{photo.caption|e}}"><span>{{photo.caption}}</span></button>{% endfor %}</div></section>
<section id="sources"><div class="eyebrow">Source register</div><h2>Complete Markdown reference</h2><p class="section-lead">Every source note below is rendered directly from the Markdown files at build time. Expand a chapter, search within source notes, or navigate to the original repository files.</p><input class="search" id="search" placeholder="Filter source chapters by title or text…" aria-label="Search source notes"><div class="toolbar"><button onclick="toggleAll(true)">Expand all</button><button onclick="toggleAll(false)">Collapse all</button></div>{% for doc in docs %}<details class="source" data-text="{{doc.search|e}}"><summary>{{doc.title}}</summary><div class="body">{{doc.html|safe}}</div></details>{% endfor %}</section>
<footer class="footer">Generated {{generated}} from Markdown and Graphviz sources. The report is a derived view; update <strong>notes/*.md</strong> and rebuild, rather than editing this HTML. User-observed facts, inferences and unknowns are intentionally separated.</footer></main></div><div class="modal" id="modal" role="dialog" aria-label="Enlarged photograph"><button id="close" aria-label="Close image">×</button><img id="large" alt=""><div class="caption" id="caption"></div></div><script>
const modal=document.getElementById('modal');document.querySelectorAll('.photo').forEach(b=>b.addEventListener('click',()=>{document.getElementById('large').src=b.dataset.image;document.getElementById('caption').textContent=b.dataset.caption;modal.classList.add('open')}));function closeModal(){modal.classList.remove('open');document.getElementById('large').removeAttribute('src')}document.getElementById('close').onclick=closeModal;modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});function toggleAll(open){document.querySelectorAll('.source').forEach(x=>x.open=open)}document.getElementById('search').addEventListener('input',e=>{const q=e.target.value.toLowerCase().trim();document.querySelectorAll('.source').forEach(d=>{d.hidden=!!q&&!d.dataset.text.includes(q);if(q&&d.dataset.text.includes(q))d.open=true})});const links=[...document.querySelectorAll('.side a')];const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){links.forEach(a=>a.classList.toggle('active',a.hash==='#'+e.target.id))}})},{rootMargin:'-15% 0px -70% 0px'});document.querySelectorAll('main section, main header').forEach(s=>obs.observe(s));
</script></body></html>
